[204.411, "o", "\u001b[2m    1\u2192#!/usr/bin/env python3\r\n         2\u2192\"\"\"Artifact Verification \u2014 PostToolUse hook for Bash.\r\n         3\u2192\r\n         4\u2192After running impact_graph.py, verifies the target graph file\r\n         5\u2192actually exists on disk. Catches the case where the script ran\r\n         6\u2192but produced no output file \u2014 \"regardless of what you believe you did.\"\r\n         7\u2192\"\"\"\r\n         8\u2192from __future__ import annotations\r\n         9\u2192\r\n        10\u2192import os\r\n        11\u2192import re\r\n        12\u2192import sys\r\n        13\u2192\r\n        14\u2192sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\r\n        15\u2192from _common import exit_ok, exit_warn, read_event\r\n    \u001b[2m    ... (44 more lines)\u001b[0m\u001b[0m\r\n"]
