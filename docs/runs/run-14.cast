[247.255, "o", "\u001b[2m    36\u2192def parse_brief(content: str) -> list[PatternEntry]:\r\n        37\u2192    \"\"\"Parse patterns-brief.md into structured entries.\"\"\"\r\n        38\u2192    entries = []\r\n        39\u2192    # Match ## PAT-NNN: name (Run N, YYYY-MM-DD)\r\n        40\u2192    header_re = re.compile(\r\n        41\u2192        r'^## (PAT-\\d+): (.+?) \\((Run \\d+), (\\d{4}-\\d{2}-\\d{2})\\)\\s*$',\r\n        42\u2192        re.MULTILINE,\r\n        43\u2192    )\r\n        44\u2192    matches = list(header_re.finditer(content))\r\n        45\u2192\r\n        46\u2192    for i, match in enumerate(matches):\r\n        47\u2192        start = match.end()\r\n        48\u2192        end = matches[i + 1].start() if i + 1 < len(matches) else len(content)\r\n        49\u2192        block = content[start:end]\r\n        50\u2192\r\n    \u001b[2m    ... (20 more lines)\u001b[0m\u001b[0m\r\n"]
