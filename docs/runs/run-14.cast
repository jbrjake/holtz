[133.201, "o", "\u001b[2m    1\u2192#!/usr/bin/env python3\r\n         2\u2192\"\"\"\r\n         3\u2192Holtz Pattern Brief Compactor\r\n         4\u2192\r\n         5\u2192Reads patterns-brief.md and produces compact representations for subagent\r\n         6\u2192consumption. Multiple output formats available; default determined by\r\n         7\u2192empirical testing.\r\n         8\u2192\r\n         9\u2192Usage:\r\n        10\u2192  python pattern_brief_compact.py [path-to-patterns-brief.md]\r\n        11\u2192  python pattern_brief_compact.py [path] --format oneliner|twoliner|structured\r\n        12\u2192\"\"\"\r\n        13\u2192\r\n        14\u2192import re\r\n        15\u2192import sys\r\n    \u001b[2m    ... (154 more lines)\u001b[0m\u001b[0m\r\n"]
