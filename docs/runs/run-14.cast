[223.677, "o", "\u001b[2m    1\u2192#!/usr/bin/env python3\r\n         2\u2192\"\"\"Impact Graph Gate \u2014 PreToolUse hook for Write|Edit.\r\n         3\u2192\r\n         4\u2192Blocks writing Phase 1+ audit files unless the corresponding\r\n         5\u2192impact-graph.json exists on disk. Enforces the HARD-GATE that\r\n         6\u2192was violated for 10+ consecutive runs despite advisory instructions.\r\n         7\u2192\"\"\"\r\n         8\u2192from __future__ import annotations\r\n         9\u2192\r\n        10\u2192import os\r\n        11\u2192import sys\r\n        12\u2192\r\n        13\u2192# Allow importing _common from the same directory\r\n        14\u2192sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\r\n        15\u2192from _common import exit_block, exit_ok, read_event\r\n    \u001b[2m    ... (43 more lines)\u001b[0m\u001b[0m\r\n"]
