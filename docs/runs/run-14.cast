[268.894, "o", "\u001b[2m    289\u2192def check_convergence(history: list) -> tuple[bool, str]:\r\n       290\u2192    \"\"\"Determine if the fix loop has converged.\"\"\"\r\n       291\u2192    if len(history) < 3:\r\n       292\u2192        return False, f\"Not enough data points (need at least 3 iterations, have {len(history)})\"\r\n       293\u2192\r\n       294\u2192    curr_pl = _get_punchlist(history[-1])\r\n       295\u2192    unknown_items = curr_pl.get(\"unknown\", 0)\r\n       296\u2192    open_items = curr_pl[\"OPEN\"] + curr_pl[\"IN PROGRESS\"] + unknown_items\r\n       297\u2192\r\n       298\u2192    # Convergence requires that items were actually found and resolved at some point.\r\n       299\u2192    # A punchlist that has always been empty (total == 0 across all history) cannot converge.\r\n       300\u2192    max_total = max(_get_punchlist(h)[\"total\"] for h in history)\r\n       301\u2192    if max_total == 0:\r\n       302\u2192        return False, \"NO ITEMS: Punchlist has never contained any items. Run audit phases first.\"\r\n       303\u2192\r\n       304\u2192    # Convergence requires items to have been resolved/deferred, not just deleted.\r\n       305\u2192    # If items existed but current total is 0, they were deleted not resolved.\r\n       306\u2192    curr_resolved_deferred = curr_pl[\"RESOLVED\"] + curr_pl[\"DEFERRED\"]\r\n       307\u2192    if max_total > 0 and curr_resolved_deferred == 0 and open_items == 0:\r\n       308\u2192        return False, (\u001b[0m\r\n"]
