[204.505, "o", "\u001b[2m    225\u2192        item.has_evidence = bool(evidence_content and len(evidence_content.strip()) > 10)\r\n       226\u2192\r\n       227\u2192        # Discovery Chain: presence check \u2014 must be at start of line (field header position),\r\n       228\u2192        # not mid-line in prose (e.g., \"missing a **Discovery Chain:** section\").\r\n       229\u2192        item.has_discovery_chain = bool(re.search(r'^\\*\\*Discovery Chain:\\*\\*', masked_block, re.MULTILINE))\r\n       230\u2192\r\n       231\u2192        # Checkbox detection: scoped to Acceptance Criteria section in masked block\r\n       232\u2192        ac_m = re.search(SECTION_RE % 'Acceptance Criteria', masked_block)\r\n       233\u2192        ac_content = ac_m.group(1) if ac_m else \"\"\r\n       234\u2192        item.has_acceptance_criteria = '- [ ]' in ac_content or '- [x]' in ac_content or '- [X]' in ac_content\r\n       235\u2192\r\n       236\u2192        # Validation command: header must exist in masked, content from original.\r\n       237\u2192        # Supports backtick and tilde fences of any length (3+), with optional\r\n       238\u2192        # blank lines between header and fence, per CommonMark spec.\r\n       239\u2192        vc_match = re.search(HEADER_RE % 'Validation Command', masked_block)\r\n    \u001b[2m    ... (15 more lines)\u001b[0m\u001b[0m\r\n"]
