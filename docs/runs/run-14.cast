[268.318, "o", "\u001b[2m    265\u2192    fd, tmp_path = tempfile.mkstemp(dir=str(target.parent), suffix=\".tmp\")\r\n       266\u2192    closed = False\r\n       267\u2192    try:\r\n       268\u2192        os.write(fd, json.dumps(history, indent=2).encode())\r\n       269\u2192        os.close(fd)\r\n       270\u2192        closed = True\r\n       271\u2192        os.replace(tmp_path, str(target))\r\n       272\u2192    except BaseException:\r\n       273\u2192        if not closed:\r\n       274\u2192            os.close(fd)\r\n       275\u2192        if os.path.exists(tmp_path):\r\n       276\u2192            os.unlink(tmp_path)\r\n       277\u2192        raise\r\n       278\u2192\r\n       279\u2192\r\n       280\u2192def _get_punchlist(entry: dict) -> dict:\r\n       281\u2192    \"\"\"Safely extract punchlist counts from a history entry.\"\"\"\r\n       282\u2192    default = {\"OPEN\": 0, \"IN PROGRESS\": 0, \"RESOLVED\": 0, \"DEFERRED\": 0, \"unknown\": 0, \"total\": 0}\r\n       283\u2192    pl = entry.get(\"punchlist\")\r\n       284\u2192    if not isinstance(pl, dict):\u001b[0m\r\n"]
