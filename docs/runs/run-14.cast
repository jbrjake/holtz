[269.654, "o", "\u001b[2m    355\u2192\r\n       356\u2192    if open_items == 0 and no_new_2_iters and not tests_stable:\r\n       357\u2192        return False, \"BLOCKED: No open punchlist items, but test failures increased\"\r\n       358\u2192\r\n       359\u2192    # Stall detection: 3+ iterations with no progress on open items\r\n       360\u2192    if len(history) >= 4:\r\n       361\u2192        last_4_pls = [_get_punchlist(h) for h in history[-4:]]\r\n       362\u2192        no_open_progress = all(\r\n       363\u2192            (last_4_pls[i+1][\"OPEN\"] + last_4_pls[i+1][\"IN PROGRESS\"] + last_4_pls[i+1].get(\"unknown\", 0))\r\n       364\u2192            >= (last_4_pls[i][\"OPEN\"] + last_4_pls[i][\"IN PROGRESS\"] + last_4_pls[i].get(\"unknown\", 0))\r\n       365\u2192            for i in range(3)\r\n       366\u2192        )\r\n       367\u2192        if no_open_progress and open_items > 0:\r\n       368\u2192            return False, (\r\n       369\u2192                f\"STALLED: {open_items} items remain open but no progress \"\r\n       370\u2192                f\"in last 3 iterations. Consider deferring remaining items.\"\r\n       371\u2192            )\r\n       372\u2192\r\n       373\u2192    prev_pl = _get_punchlist(history[-2])\r\n       374\u2192    new_items = curr_pl[\"total\"] - prev_pl[\"total\"]\u001b[0m\r\n"]
