[175.8, "o", "  \u001b[36m\u23bf Edit\u001b[0m \u001b[2mRendering/PipelineBootstrap.swift\u001b[0m\r\n"]
[175.95, "o", "\r\nNow let's test:\r\n"]
[177.45, "o", "\u001b[2m  [212,222 ctx | 4 out]\u001b[0m\r\n"]
[178.25, "o", "  \u001b[36m\u23bf Bash\u001b[0m \u001b[2mRun integration tests with runtime shader compilation\u001b[0m\r\n"]
[178.4, "o", "\r\nThe runtime compilation fallback isn't working. Let me debug:\r\n"]
[179.9, "o", "\u001b[2m  [213,626 ctx | 8 out]\u001b[0m\r\n"]
[180.7, "o", "  \u001b[36m\u23bf Bash\u001b[0m \u001b[2mCheck bundle resource resolution\u001b[0m\r\n"]
