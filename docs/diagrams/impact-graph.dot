digraph {
  rankdir=LR
  bgcolor="transparent"
  pad=0.5
  nodesep=0.4
  ranksep=1.2

  node [
    fontname="Helvetica"
    fontsize=10
    style="filled,rounded"
    penwidth=1.5
    margin="0.12,0.08"
  ]

  edge [
    fontname="Helvetica"
    fontsize=8
    penwidth=1.0
    arrowsize=0.7
  ]

  // Modules — blue-gray
  validate_punchlist [
    label="validate_punchlist"
    fillcolor="#bee3f8" color="#3182ce" fontcolor="#2a4365"
  ]
  convergence_check [
    label="convergence_check"
    fillcolor="#bee3f8" color="#3182ce" fontcolor="#2a4365"
  ]
  impact_graph_mod [
    label="impact_graph"
    fillcolor="#bee3f8" color="#3182ce" fontcolor="#2a4365"
  ]
  markdown_utils [
    label="markdown_utils"
    fillcolor="#bee3f8" color="#3182ce" fontcolor="#2a4365"
  ]

  // Functions — light gray
  parse_punchlist [
    label="parse_punchlist()"
    fillcolor="#f0f4f8" color="#4a5568" fontcolor="#1a202c"
  ]
  validate_fn [
    label="validate()"
    fillcolor="#f0f4f8" color="#4a5568" fontcolor="#1a202c"
  ]
  count_items [
    label="count_items()"
    fillcolor="#f0f4f8" color="#4a5568" fontcolor="#1a202c"
  ]
  check_convergence [
    label="check_convergence()"
    fillcolor="#f0f4f8" color="#4a5568" fontcolor="#1a202c"
  ]
  save_history [
    label="save_history()"
    fillcolor="#f0f4f8" color="#4a5568" fontcolor="#1a202c"
  ]
  mask_code_fences [
    label="mask_code_fences()"
    fillcolor="#f0f4f8" color="#4a5568" fontcolor="#1a202c"
  ]

  // Class — purple
  ImpactGraph [
    label="ImpactGraph"
    fillcolor="#e9d8fd" color="#6b46c1" fontcolor="#44337a"
  ]

  // Hooks — amber
  artifact_verification [
    label="artifact_verification"
    fillcolor="#fefcbf" color="#d69e2e" fontcolor="#744210"
  ]
  impact_graph_gate [
    label="impact_graph_gate"
    fillcolor="#fefcbf" color="#d69e2e" fontcolor="#744210"
  ]
  status_staleness_gate [
    label="status_staleness_gate"
    fillcolor="#fefcbf" color="#d69e2e" fontcolor="#744210"
  ]
  subagent_findings_check [
    label="subagent_findings_check"
    fillcolor="#fefcbf" color="#d69e2e" fontcolor="#744210"
  ]
  hooks_common [
    label="_common"
    fillcolor="#fefcbf" color="#d69e2e" fontcolor="#744210"
  ]

  // Doc — green
  readme [
    label="README.md"
    fillcolor="#c6f6d5" color="#38a169" fontcolor="#22543d"
  ]

  // Import edges — solid gray
  validate_punchlist -> markdown_utils [color="#a0aec0" label="imports"]
  convergence_check -> markdown_utils [color="#a0aec0" label="imports"]
  artifact_verification -> hooks_common [color="#a0aec0" label="imports"]
  impact_graph_gate -> hooks_common [color="#a0aec0" label="imports"]
  status_staleness_gate -> hooks_common [color="#a0aec0" label="imports"]
  subagent_findings_check -> hooks_common [color="#a0aec0" label="imports"]

  // Call edges — solid blue
  parse_punchlist -> mask_code_fences [color="#3182ce" label="calls"]
  count_items -> mask_code_fences [color="#3182ce" label="calls"]

  // Assumes edges — dashed red, the interesting ones
  parse_punchlist -> count_items [
    color="#e53e3e" style=dashed penwidth=1.5
    label="assumes\nheader format\nmust stay aligned"
  ]
  artifact_verification -> ImpactGraph [
    color="#e53e3e" style=dashed penwidth=1.5
    label="assumes\ncreates file\nat --graph path"
  ]
  readme -> validate_punchlist [
    color="#e53e3e" style=dashed penwidth=1.5
    label="assumes\ncounts match\nactual files"
  ]
  ImpactGraph -> check_convergence [
    color="#e53e3e" style=dashed penwidth=1.5
    label="assumes\ndelta is finite\nrisk_score valid"
  ]
  convergence_check -> validate_punchlist [
    color="#e53e3e" style=dashed penwidth=1.5
    label="assumes\ncompatible\nheader regex"
  ]
  status_staleness_gate -> impact_graph_gate [
    color="#e53e3e" style=dashed penwidth=1.5
    label="assumes\nsame cwd\nresolution"
  ]
}
