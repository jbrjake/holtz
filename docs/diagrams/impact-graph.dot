digraph {
  rankdir=LR
  bgcolor="transparent"
  pad=0.5
  nodesep=0.4
  ranksep=1.2

  node [
    fontname="Helvetica"
    fontsize=10
    style="filled,rounded"
    penwidth=1.5
    margin="0.12,0.08"
  ]

  edge [
    fontname="Helvetica"
    fontsize=8
    penwidth=1.0
    arrowsize=0.7
  ]

  // Modules — blue-gray
  validate_punchlist [
    label="validate_punchlist"
    fillcolor="#bee3f8" color="#3182ce" fontcolor="#2a4365"
  ]
  convergence_check [
    label="convergence_check"
    fillcolor="#bee3f8" color="#3182ce" fontcolor="#2a4365"
  ]
  impact_graph_mod [
    label="impact_graph"
    fillcolor="#bee3f8" color="#3182ce" fontcolor="#2a4365"
  ]
  markdown_utils [
    label="markdown_utils"
    fillcolor="#bee3f8" color="#3182ce" fontcolor="#2a4365"
  ]

  // Functions — light gray
  parse_punchlist [
    label="parse_punchlist()"
    fillcolor="#f0f4f8" color="#4a5568" fontcolor="#1a202c"
  ]
  count_items [
    label="count_items()"
    fillcolor="#f0f4f8" color="#4a5568" fontcolor="#1a202c"
  ]
  check_convergence [
    label="check_convergence()"
    fillcolor="#f0f4f8" color="#4a5568" fontcolor="#1a202c"
  ]
  mask_code_fences [
    label="mask_code_fences()"
    fillcolor="#f0f4f8" color="#4a5568" fontcolor="#1a202c"
  ]
  filter_items [
    label="filter_items()"
    fillcolor="#f0f4f8" color="#4a5568" fontcolor="#1a202c"
  ]
  render_items [
    label="render_items()"
    fillcolor="#f0f4f8" color="#4a5568" fontcolor="#1a202c"
  ]

  // Class — purple
  ImpactGraph [
    label="ImpactGraph"
    fillcolor="#e9d8fd" color="#6b46c1" fontcolor="#44337a"
  ]

  // Enforcement hooks — amber
  write_guard [
    label="write_guard"
    fillcolor="#fefcbf" color="#d69e2e" fontcolor="#744210"
  ]
  lens_quiz [
    label="lens_quiz"
    fillcolor="#fefcbf" color="#d69e2e" fontcolor="#744210"
  ]
  protocol_tracker [
    label="protocol_tracker"
    fillcolor="#fefcbf" color="#d69e2e" fontcolor="#744210"
  ]
  subagent_findings_check [
    label="subagent_findings_check"
    fillcolor="#fefcbf" color="#d69e2e" fontcolor="#744210"
  ]
  _protocol_cache [
    label="_protocol_cache"
    fillcolor="#fefcbf" color="#d69e2e" fontcolor="#744210"
  ]

  // Docs — green
  readme [
    label="README.md"
    fillcolor="#c6f6d5" color="#38a169" fontcolor="#22543d"
  ]
  references [
    label="references/"
    fillcolor="#c6f6d5" color="#38a169" fontcolor="#22543d"
  ]
  lens_registry [
    label="lens-registry.md"
    fillcolor="#c6f6d5" color="#38a169" fontcolor="#22543d"
  ]

  // Tests — light indigo
  test_enforcement [
    label="test_enforcement"
    fillcolor="#e8e0f0" color="#805ad5" fontcolor="#44337a"
  ]
  test_validate_punchlist [
    label="test_validate_punchlist"
    fillcolor="#e8e0f0" color="#805ad5" fontcolor="#44337a"
  ]
  test_convergence_check [
    label="test_convergence_check"
    fillcolor="#e8e0f0" color="#805ad5" fontcolor="#44337a"
  ]
  test_impact_graph [
    label="test_impact_graph"
    fillcolor="#e8e0f0" color="#805ad5" fontcolor="#44337a"
  ]
  test_integration [
    label="test_integration"
    fillcolor="#e8e0f0" color="#805ad5" fontcolor="#44337a"
  ]
  test_markdown_utils [
    label="test_markdown_utils"
    fillcolor="#e8e0f0" color="#805ad5" fontcolor="#44337a"
  ]

  // Import edges — solid gray
  validate_punchlist -> markdown_utils [color="#a0aec0" fontcolor="#90cdf4" label="imports"]
  convergence_check -> markdown_utils [color="#a0aec0" fontcolor="#90cdf4" label="imports"]
  write_guard -> _protocol_cache [color="#a0aec0" fontcolor="#90cdf4" label="imports"]
  lens_quiz -> _protocol_cache [color="#a0aec0" fontcolor="#90cdf4" label="imports"]
  protocol_tracker -> _protocol_cache [color="#a0aec0" fontcolor="#90cdf4" label="imports"]

  // Call edges — solid blue
  parse_punchlist -> mask_code_fences [color="#3182ce" fontcolor="#63b3ed" label="calls"]
  count_items -> mask_code_fences [color="#3182ce" fontcolor="#63b3ed" label="calls"]
  render_items -> parse_punchlist [color="#3182ce" fontcolor="#63b3ed" label="calls"]
  render_items -> mask_code_fences [color="#3182ce" fontcolor="#63b3ed" label="calls"]
  filter_items -> parse_punchlist [color="#3182ce" fontcolor="#63b3ed" label="calls"]

  // Test edges — dotted purple
  test_enforcement -> write_guard [color="#805ad5" style=dotted fontcolor="#b794f4" label="tests"]
  test_enforcement -> lens_quiz [color="#805ad5" style=dotted fontcolor="#b794f4" label="tests"]
  test_enforcement -> protocol_tracker [color="#805ad5" style=dotted fontcolor="#b794f4" label="tests"]
  test_enforcement -> subagent_findings_check [color="#805ad5" style=dotted fontcolor="#b794f4" label="tests"]
  test_validate_punchlist -> validate_punchlist [color="#805ad5" style=dotted fontcolor="#b794f4" label="tests"]
  test_convergence_check -> convergence_check [color="#805ad5" style=dotted fontcolor="#b794f4" label="tests"]
  test_impact_graph -> impact_graph_mod [color="#805ad5" style=dotted fontcolor="#b794f4" label="tests"]
  test_markdown_utils -> markdown_utils [color="#805ad5" style=dotted fontcolor="#b794f4" label="tests"]
  test_integration -> validate_punchlist [color="#805ad5" style=dotted fontcolor="#b794f4" label="tests"]
  test_integration -> convergence_check [color="#805ad5" style=dotted fontcolor="#b794f4" label="tests"]

  // Assumes edges — dashed red, the interesting ones
  parse_punchlist -> count_items [
    color="#e53e3e" style=dashed penwidth=1.5
    fontcolor="#fc8181"
    label="assumes\nheader format\nmust stay aligned"
  ]
  ImpactGraph -> check_convergence [
    color="#e53e3e" style=dashed penwidth=1.5
    fontcolor="#fc8181"
    label="assumes\ndelta is finite\nrisk_score valid"
  ]
  readme -> validate_punchlist [
    color="#e53e3e" style=dashed penwidth=1.5
    fontcolor="#fc8181"
    label="assumes\ncounts match\nactual files"
  ]
  convergence_check -> validate_punchlist [
    color="#e53e3e" style=dashed penwidth=1.5
    fontcolor="#fc8181"
    label="assumes\ncompatible\nheader regex"
  ]
  ImpactGraph -> impact_graph_mod [
    color="#e53e3e" style=dashed penwidth=1.5
    fontcolor="#fc8181"
    label="assumes\nedges have\nsource/target/type"
  ]
  render_items -> parse_punchlist [
    color="#e53e3e" style=dashed penwidth=1.5
    fontcolor="#fc8181"
    label="assumes\nmasked offsets\nmatch original"
    constraint=false
  ]
  lens_quiz -> lens_registry [
    color="#e53e3e" style=dashed penwidth=1.5
    fontcolor="#fc8181"
    label="assumes\nquiz answers match\nregistry content"
  ]
  protocol_tracker -> convergence_check [
    color="#e53e3e" style=dashed penwidth=1.5
    fontcolor="#fc8181"
    label="assumes\nsame state\nlabels"
  ]

  // Diverges_from edges — dashed orange
  readme -> references [
    color="#dd6b20" style=dashed penwidth=1.5
    fontcolor="#ed8936"
    label="diverges_from\ncount mismatch"
  ]
}
