#!/usr/bin/env bash
# Pre-commit gate: fast CI-equivalent checks.
#
# The CI workflow (.github/workflows/ci.yml) runs, in order: ruff → mypy
# → pytest with coverage → contract gate. Divergence between local
# gates and CI is how trivial failures ship: "I ran mypy" turned into
# broken pushes because pytest was never run locally. This hook's job
# is to make the local bar match CI for the fast subset; the slow
# subset (full pytest) runs in pre-push (scripts/pre-release-check.sh).
#
# Order matches CI: the fastest gates run first so we fail early.
#
# On staged-file changes under hooks/ or enforcement/hooks/, we also
# auto-regenerate trusted-callers.toml and re-stage it — the manifest
# protects daemon auth and must match the hashes of these files.
#
# Bypass (emergency only, e.g. known CI-side fix): `git commit --no-verify`.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Activate venv so ruff/mypy/pytest are on PATH.
if [[ -f .venv/bin/activate ]]; then
    # shellcheck disable=SC1091
    source .venv/bin/activate
fi

CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
CHANGED_PY=$(echo "$CHANGED_FILES" | grep -E '\.py$' || true)

# ── Enforcement layering (#82) ──
#
# Runs on TOML/skill/hook changes, before the Python gates, because it is the
# cheap one: config in, findings out, no ledger and no gate execution. #73,
# #77 and #79 were all decidable at rest from files we already parse, and all
# three were found the expensive way instead — by a live audit run hitting the
# wall. This is the gate that makes the next one fail here rather than there.
CHANGED_ENFORCEMENT=$(echo "$CHANGED_FILES" \
    | grep -E '^(enforcement/.*\.(toml|py)|skills/.*\.md|hooks/hooks\.json)$' || true)
if [[ -n "$CHANGED_ENFORCEMENT" ]]; then
    # The contract doc is derived, so regenerate and re-stage it rather than
    # making the dev remember — same treatment as trusted-callers.toml below.
    # It is re-staged, not silently rewritten: the diff lands in the commit,
    # which is the point of generating it at all. A row that changes from
    # `host` to `ambient` is a defect you can see in review without running
    # anything, and CI re-checks it for anyone who bypassed this hook.
    if ! python3 scripts/enforcement_contract.py --check >/dev/null 2>&1; then
        echo "pre-commit: enforcement config changed — regenerating ENFORCEMENT-CONTRACT.md"
        python3 scripts/enforcement_contract.py --write >/dev/null
        git --no-pager diff --stat -- docs/ENFORCEMENT-CONTRACT.md
        git add docs/ENFORCEMENT-CONTRACT.md
    fi

    echo "pre-commit: enforcement lint"
    if ! bash scripts/lint-enforcement.sh; then
        echo "pre-commit: enforcement lint failed — a gate does not mean what it says." >&2
        echo "            Fix and re-commit (or --no-verify to bypass)." >&2
        exit 1
    fi
fi

# ── Auto-regen trusted-callers manifest when its inputs changed ──
#
# Anything under hooks/ or enforcement/hooks/ that's in the manifest
# needs re-hashing. The dev shouldn't have to remember to run
# scripts/hash-trusted-callers.sh — the hook does it and re-stages
# the result so the commit stays coherent.
CHANGED_TRACKED_CALLER=$(echo "$CHANGED_FILES" \
    | grep -E '^(enforcement/hooks/.*\.py|hooks/.*\.py|skills/holtz/scripts/.*\.py)$' || true)
if [[ -n "$CHANGED_TRACKED_CALLER" ]]; then
    echo "pre-commit: tracked caller(s) changed — regenerating trusted-callers.toml"
    bash scripts/hash-trusted-callers.sh >/dev/null
    git add enforcement/trusted-callers.toml
fi

# Skip the Python-targeted gates if no Python changed. A doc-only commit
# shouldn't pay the mypy/pytest cost.
if [[ -z "$CHANGED_PY" ]]; then
    exit 0
fi

echo "pre-commit: ruff check"
if ! ruff check .; then
    echo "pre-commit: ruff failed. Fix and re-commit (or --no-verify to bypass)." >&2
    exit 1
fi

echo "pre-commit: mypy"
if ! mypy --explicit-package-bases \
        skills/holtz/scripts/ \
        hooks/ \
        enforcement/hooks/ \
        scripts/ \
        enforcement/scripts/; then
    echo "pre-commit: mypy failed. Fix and re-commit (or --no-verify to bypass)." >&2
    exit 1
fi

# Fast pytest subset: skip the slow/machine-specific tests. The full
# suite runs in pre-push. This keeps pre-commit snappy (seconds) while
# still catching the common regressions — including the trusted-callers
# hash freshness test, which is what surfaces stale manifests without
# needing a separate gate.
echo "pre-commit: pytest (fast subset)"
if ! python -m pytest -q --tb=short \
        -m "not slow and not machine_specific" \
        2>&1 | tail -30; then
    echo "pre-commit: pytest failed. Fix and re-commit (or --no-verify to bypass)." >&2
    exit 1
fi

echo "pre-commit: contract gate"
if ! python scripts/contract_gate.py; then
    echo "pre-commit: contract gate failed. Fix and re-commit (or --no-verify to bypass)." >&2
    exit 1
fi
